{
  "name": "aethercore",
  "version": "0.1.0",
  "description": "A deckbuilding roguelike where you build your cards from scavenged parts.",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "node tools/serve.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "validate-data": "node tools/validate-data.js",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run validate-data && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "electron": "^44.5.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
